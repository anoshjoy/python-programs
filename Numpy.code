            "Maximum: 89\n",
            "Minimum: 7\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 5. Square and Square Root ---\")\n",
        "arr5 = np.array([4, 9, 16, 25])\n",
        "print(\"Square:\", np.square(arr5))\n",
        "print(\"Square Root:\", np.sqrt(arr5))"
      ],
      "metadata": {

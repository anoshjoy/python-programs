            " [[-4 -4]\n",
            " [-4 -4]]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 9. Matrix Multiplication (@) ---\")\n",
        "print(\"Result:\\n\", M1 @ M2)"
      ],

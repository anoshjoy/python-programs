        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "--- 8. Add and Subtract Matrices ---\n",
            "Matrix Addition:\n",
            " [[ 6  8]\n",
            " [10 12]]\n",

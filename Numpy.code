        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "--- 7. User Input Matrix ---\n",
            "Enter number of rows (e.g., 2): 2\n",
            "Enter number of columns (e.g., 2): 2\n",
            "Enter exactly 4 space-separated numbers: 3 4 5 6 \n",
            "User Matrix:\n",
            " [[3 4]\n",
            " [5 6]]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 8. Add and Subtract Matrices ---\")\n",
        "M1 = np.array([[1, 2], [3, 4]])\n",
        "M2 = np.array([[5, 6], [7, 8]])\n",
        "print(\"Matrix Addition:\\n\", M1 + M2)\n",
        "print(\"Matrix Subtraction:\\n\", M1 - M2)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "WEryWZ-y1GvU",
        "outputId": "1eb55303-97ed-4298-f7e6-24d414479f70"

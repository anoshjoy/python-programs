    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 18. Student-wise and Subject-wise Average Marks ---\")\n",
        "marks = np.array([\n",
        "    [85, 90, 78],\n",
        "    [72, 88, 91],\n",
        "    [90, 92, 85]\n",
        "])\n",
        "print(\"Student-wise Average (axis=1):\", np.mean(marks, axis=1))\n",
        "print(\"Subject-wise Average (axis=0):\", np.mean(marks, axis=0))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "EsTnCHC73ZZm",

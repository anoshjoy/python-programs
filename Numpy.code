          "text": [
            "\n",
            "--- 3. Array Arithmetic ---\n",
            "Addition: [12 25 40]\n",
            "Subtraction: [ 8 15 20]\n",
            "Multiplication: [ 20 100 300]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 4. Sum, Mean, Max, Min ---\")\n",
        "arr4 = np.array([12, 45, 7, 23, 56, 89])\n",
        "print(\"Sum:\", np.sum(arr4))\n",
        "print(\"Mean:\", np.mean(arr4))\n",
        "print(\"Maximum:\", np.max(arr4))\n",
        "print(\"Minimum:\", np.min(arr4))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Fe2i9lv8zeX-",
        "outputId": "16ea4d03-c3e8-40fa-fe76-cf3bd99d3738"

          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 10. Matrix Transpose ---\")\n",
        "M3 = np.array([[1, 2, 3], [4, 5, 6]])\n",
        "print(\"Transpose:\\n\", M3.T)"
      ],

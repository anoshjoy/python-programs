          "text": [
            "\n",
            "--- 6. Boolean Indexing ---\n",
            "Elements greater than 10: [12 18 25 30]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 7. User Input Matrix ---\")\n",
        "rows = int(input(\"Enter number of rows (e.g., 2): \"))\n",
        "cols = int(input(\"Enter number of columns (e.g., 2): \"))\n",
        "elements = list(map(int, input(f\"Enter {rows * cols} space-separated numbers: \").split()))\n",
        "user_matrix = np.array(elements).reshape(rows, cols)\n",
        "print(\"User Matrix:\\n\", user_matrix)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0megIpIL0Ccq",
        "outputId": "3308e6c1-05a3-47ee-8c19-ea2c7c43a173"
      },
      "execution_count": null,

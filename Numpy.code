            "Square Root: [2. 3. 4. 5.]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 6. Boolean Indexing ---\")\n",
        "arr6 = np.array([5, 12, 18, 3, 25, 8, 30])\n",
        "num = 10\n",
        "print(f\"Elements greater than {num}:\", arr6[arr6 > num])"
      ],
      "metadata": {

          ]
        }
      ],
      "source": [
        "import numpy as np\n",
        "print(\"--- 1. Size, Dimensions, Shape ---\")\n",
        "arr1 = np.array([[1, 2, 3], [4, 5, 6]])\n",
        "print(\"Size:\", arr1.size)\n",
        "print(\"Dimensions:\", arr1.ndim)\n",
        "print(\"Shape:\", arr1.shape)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 2. Indexing and Slicing ---\")\n",
        "arr2 = np.array([10, 20, 30, 40, 50, 60])\n",
        "print(\"Element at index 2:\", arr2[2])\n",
        "print(\"Last element:\", arr2[-1])\n",
        "print(\"Slice (1 to 4):\", arr2[1:5])\n",
        "print(\"Every 2nd element:\", arr2[::2])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jvxeKua_y-IJ",
        "outputId": "6cb471d0-e428-4f93-c9a7-8a49ac0f7db6"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "--- 2. Indexing and Slicing ---\n",
            "Element at index 2: 30\n",
            "Last element: 60\n",
            "Slice (1 to 4): [20 30 40 50]\n",
            "Every 2nd element: [10 30 50]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\n--- 3. Array Arithmetic ---\")\n",
        "a = np.array([10, 20, 30])\n",
        "b = np.array([2, 5, 10])\n",
        "print(\"Addition:\", a + b)\n",
        "print(\"Subtraction:\", a - b)\n",
        "print(\"Multiplication:\", a * b)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "j3hewA3rzOhg",
        "outputId": "f4efa354-5b10-49e7-8b31-1909adaa26fc"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
